{
  "schema_version": "1.0.0",
  "password": {
    "algorithm": "argon2id",
    "memory_kib": 19456,
    "iterations": 2,
    "parallelism": 1,
    "minimum_length": 12,
    "maximum_length": 128,
    "pepper_source": "secret-store"
  },
  "session": {
    "access_ttl_seconds": 900,
    "refresh_ttl_seconds": 2592000,
    "refresh_rotation": true,
    "reuse_detection": "revoke-family",
    "cookie": { "http_only": true, "secure_in_production": true, "same_site": "lax", "path": "/" },
    "csrf": "double-submit-cookie"
  },
  "oidc": {
    "flow": "authorization-code",
    "pkce": "S256",
    "checks": ["state", "nonce", "issuer", "audience", "signature"],
    "transaction_ttl_seconds": 600
  },
  "mfa": {
    "method": "totp",
    "period_seconds": 30,
    "digits": 6,
    "accepted_window": 1,
    "max_attempts": 5,
    "challenge_ttl_seconds": 300,
    "recovery_codes": 10,
    "secret_encryption": "AES-256-GCM"
  },
  "risk": {
    "login_attempts": 8,
    "window_seconds": 900,
    "lock_after_failures": 10,
    "lock_seconds": 900,
    "ip_storage": "HMAC of IPv4 /24 or IPv6 /64 prefix",
    "device_binding": "HMAC of random browser device identifier"
  },
  "forbidden_storage": [
    "raw password",
    "raw refresh token",
    "raw session token",
    "raw IP",
    "raw TOTP secret",
    "OTP value"
  ]
}
