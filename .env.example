NODE_ENV=development
APP_VERSION=dev
PUBLIC_BASE_URL=http://localhost:3000/mohtavayab
WEB_PORT=3000
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mohtavayab
POSTGRES_USER=mohtavayab
POSTGRES_PASSWORD=change-in-local-env
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=mohtavayab-local
MINIO_ROOT_PASSWORD=change-in-local-env
TEMPORAL_ADDRESS=temporal:7233
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
AUTH_PASSWORD_PEPPER=change-in-local-env-password-pepper-32-chars
AUTH_TOKEN_PEPPER=change-in-local-env-token-pepper-32-chars
AUTH_JWT_SECRET=change-in-local-env-jwt-secret-at-least-32-chars
AUTH_MFA_ENCRYPTION_KEY=change-in-local-env-mfa-key-at-least-32-chars
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_TRUST_PROXY=false
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=disabled-in-local-env
OIDC_GOOGLE_CLIENT_SECRET=disabled-in-local-env
OIDC_GOOGLE_REDIRECT_URI=http://localhost:3001/mohtavayab/api/auth/oidc/google/callback
